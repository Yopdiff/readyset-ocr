+    
+    var body: some View {
+        Form {
+            Section {
+                MascotView(size: 180, morph: morph, expression: expression,
+                           lookOffset: CGSize(width: look, height: 0),
+                           squash: CGFloat(squash))
+                .frame(maxWidth: .infinity)
+                .padding(.vertical, 32)
+            }
+            
+            Section("Shape: \(formName)") {
+                Slider(value: $morph, in: 0...4)
+                Button("Morph to next shape") {
+                    withAnimation(.spring(duration: 0.9, bounce: 0.35)) {
+                        morph = morph.rounded() + 1
+                    }
+                }
+                Button("Reset to square") {
