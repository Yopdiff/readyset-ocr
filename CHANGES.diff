+                }
+            }
+            
+            Section("Expression") {
+                Picker("Expression", selection: $expression) {
+                    ForEach(MascotExpression.allCases, id: \.self) { item in
+                        Text(item.rawValue.capitalized).tag(item)
+                    }
+                }
+                .pickerStyle(.segmented)
+            }
+            
+            Section("Squash & look") {
+                LabeledContent("Squash") { Slider(value: $squash, in: -1...1) }
+                LabeledContent("Look") { Slider(value: $look, in: -1...1) }
+            }
+        }
+        .navigationTitle("Mascot test")
+    }
+}
