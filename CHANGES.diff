+// MARK: - 가만히 있는 마스코트 (숨쉬기·깜빡임·시선 / 기쁘게 통통)
+
+struct IdleMascot: View {
+    enum Mood { case calm, happy }
+    
+    var size: CGFloat = 96
+    var mood: Mood = .calm
+    var look: CGSize = .zero
+    
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    @State private var startDate = Date()
+    
+    var body: some View {
+        TimelineView(.animation) { context in
+            let time = context.date.timeIntervalSince(startDate)
+            let pose = reduceMotion ? IdleMotion.Pose() : IdleMotion.pose(at: time, mood: mood)
+            
+            MascotView(
+                size: size,
+                expression: mood == .happy ? .happy : .normal,
+                eyeOpenness: mood == .happy ? 1 : MascotMotion.eyeOpenness(at: time),
+                lookOffset: look,
+                squash: pose.squash,
+                hop: pose.hop
+            )
+        }
+    }
+}
+
+enum IdleMotion {
+    struct Pose {
+        var hop: CGFloat = 0
+        var squash: CGFloat = 0
+    }
+    
+    static func pose(at time: TimeInterval, mood: IdleMascot.Mood) -> Pose {
+        switch mood {
+        case .calm:
+            // 숨 쉬듯 아주 살짝 출렁
+            return Pose(hop: 0, squash: CGFloat(0.12 * sin(time * 2.2)))
+        case .happy:
+            // 통통 뛰기: 공중에서는 쭉 늘어나고, 착지하면 눌렸다가 출렁
+            let period = 1.1
+            let p = time.truncatingRemainder(dividingBy: period) / period
+            if p < 0.45 {
+                let s = sin(Double.pi * p / 0.45)
+                return Pose(hop: CGFloat(0.35 * s), squash: CGFloat(-0.35 * s))
+            } else {
+                let u = (p - 0.45) / 0.55
+                return Pose(hop: 0, squash: CGFloat(0.5 * exp(-4 * u) * sin(3 * Double.pi * u)))
+            }
+        }
+    }
+}
