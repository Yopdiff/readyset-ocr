+                    Text("Animation 1")
+                        .font(AppFont.montserrat(14, .semibold, relativeTo: .headline))
+                }
+                VStack(spacing: 16) {
+                    AnimatedMascot(size: 130, style: .spin, isFinished: isFinished, cycleDuration: 3.6)
+                    Text("Animation 2")
+                        .font(AppFont.montserrat(14, .semibold, relativeTo: .headline))
+                }
+            }
+            .id(runID)
+            
+            Text(isFinished ? "Done!" : "Looping…")
+                .font(AppFont.montserrat(13, relativeTo: .subheadline))
+                .foregroundStyle(AppColor.primary.opacity(0.7))
+            Spacer()
+            Button(isFinished ? "Restart" : "Finish") {
+                if isFinished {
+                    isFinished = false
+                    runID = UUID()          // 처음부터 다시
+                } else {
+                    isFinished = true
+                }
+            }
+            .buttonStyle(.borderedProminent)
+            .tint(AppColor.primary)
+        }
+        .padding(24)
+        .navigationTitle("Mascot animation")
+    }
+}
+
+struct MascotAnimationTestLinkRow: View {
+    var body: some View {
+        NavigationLink {
+            MascotAnimationTestView()
+        } label: {
+            Text("Mascot animation")
+        }
+    }
+}
+
+#Preview {
+    HStack(spacing: 32) {
+        AnimatedMascot(size: 120, style: .bouncy)
+        AnimatedMascot(size: 120, style: .spin)
+    }
